# Data directory for metadata DB, uploads, references and trusted partitions.
GSB_DATA_DIR=./data
# Baseline dataset/rule definitions loaded on startup for missing datasets.
GSB_RULES_FILE=./config/rules.yaml
# Per-file and total-per-request upload limit in bytes (default 512 MiB).
GSB_MAX_UPLOAD_BYTES=536870912
# Maximum number of parquet files per batch.
GSB_MAX_FILES=50
